<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #0ea5e9;
      --primary-glow: rgba(14, 165, 233, 0.4);
      --emerald: #10b981;
      --emerald-glow: rgba(16, 185, 129, 0.45);
      --bg-dark: #070b14;
      --card-bg: rgba(15, 23, 42, 0.65);
      --card-border: rgba(255, 255, 255, 0.08);
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow-x: hidden;
      padding: 1.5rem;
    }

    /* Ambient Background Glows */
    .glow-bg {
      position: fixed;
      width: 500px;
      height: 500px;
      border-radius: 50%;
      filter: blur(120px);
      pointer-events: none;
      z-index: 0;
      opacity: 0.5;
      animation: floatGlow 12s ease-in-out infinite alternate;
    }
    .glow-1 {
      top: -100px;
      left: -100px;
      background: radial-gradient(circle, #0284c7, transparent 70%);
    }
    .glow-2 {
      bottom: -100px;
      right: -100px;
      background: radial-gradient(circle, #059669, transparent 70%);
      animation-delay: -6s;
    }

    @keyframes floatGlow {
      0% { transform: translate(0, 0) scale(1); }
      100% { transform: translate(60px, 40px) scale(1.15); }
    }

    /* Grid Overlay */
    .grid-pattern {
      position: fixed;
      inset: 0;
      background-image: 
        linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
      background-size: 40px 40px;
      z-index: 0;
      pointer-events: none;
    }

    /* Main Container */
    .container {
      position: relative;
      z-index: 10;
      max-width: 820px;
      width: 100%;
      background: var(--card-bg);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--card-border);
      border-radius: 28px;
      padding: 2.75rem 2.25rem;
      box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.7),
                  0 0 40px -10px var(--primary-glow);
      text-align: center;
      animation: cardAppear 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes cardAppear {
      from {
        opacity: 0;
        transform: translateY(30px) scale(0.97);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    /* Top Badge */
    .status-badge-wrap {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.3);
      padding: 0.45rem 1.1rem;
      border-radius: 9999px;
      font-size: 0.85rem;
      font-weight: 600;
      color: #34d399;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      box-shadow: 0 0 20px rgba(16, 185, 129, 0.2);
      margin-bottom: 1.5rem;
    }

    .pulse-dot {
      width: 10px;
      height: 10px;
      background-color: #10b981;
      border-radius: 50%;
      position: relative;
    }

    .pulse-dot::after {
      content: '';
      position: absolute;
      inset: -4px;
      border-radius: 50%;
      background: inherit;
      opacity: 0.6;
      animation: ripple 1.8s cubic-bezier(0, 0.2, 0.8, 1) infinite;
    }

    @keyframes ripple {
      0% { transform: scale(1); opacity: 0.8; }
      100% { transform: scale(3.2); opacity: 0; }
    }

    /* Medical Icon & Title */
    .icon-header {
      width: 76px;
      height: 76px;
      margin: 0 auto 1.25rem;
      background: linear-gradient(135deg, rgba(14, 165, 233, 0.2), rgba(16, 185, 129, 0.2));
      border: 1px solid rgba(14, 165, 233, 0.35);
      border-radius: 22px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 10px 25px -5px var(--primary-glow);
      animation: floatIcon 4s ease-in-out infinite alternate;
    }

    @keyframes floatIcon {
      0% { transform: translateY(0); }
      100% { transform: translateY(-8px); }
    }

    .icon-header svg {
      width: 42px;
      height: 42px;
      fill: none;
      stroke: url(#brandGrad);
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    h1 {
      font-size: 2.35rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.2;
      margin-bottom: 0.6rem;
      background: linear-gradient(135deg, #ffffff 40%, #93c5fd 80%, #34d399 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .subtitle {
      font-size: 1.05rem;
      color: var(--text-muted);
      max-width: 580px;
      margin: 0 auto 1.75rem;
      line-height: 1.6;
    }

    /* Animated Heartbeat / ECG Wave */
    .ecg-box {
      width: 100%;
      height: 48px;
      margin-bottom: 2rem;
      position: relative;
      overflow: hidden;
      border-radius: 12px;
      background: rgba(2, 6, 23, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.04);
      display: flex;
      align-items: center;
    }

    .ecg-svg {
      width: 200%;
      height: 100%;
      position: absolute;
      left: 0;
      top: 0;
      animation: slideEcg 4s linear infinite;
    }

    @keyframes slideEcg {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    /* Stats Grid */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
      text-align: left;
    }

    .stat-card {
      background: rgba(2, 6, 23, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.05);
      padding: 1.15rem 1.25rem;
      border-radius: 18px;
      transition: all 0.25s ease;
    }

    .stat-card:hover {
      background: rgba(15, 23, 42, 0.85);
      border-color: rgba(14, 165, 233, 0.3);
      transform: translateY(-3px);
      box-shadow: 0 8px 20px -6px var(--primary-glow);
    }

    .stat-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      font-weight: 600;
      color: var(--text-muted);
      letter-spacing: 0.06em;
      margin-bottom: 0.35rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .stat-value {
      font-size: 1.05rem;
      font-weight: 700;
      color: #ffffff;
      font-family: 'JetBrains Mono', monospace;
    }

    .stat-value.healthy {
      color: #34d399;
    }

    /* Quick Action Buttons */
    .actions-wrap {
      display: flex;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1.4rem;
      border-radius: 14px;
      font-size: 0.9rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .btn-primary {
      background: linear-gradient(135deg, #0ea5e9, #0284c7);
      color: #ffffff;
      box-shadow: 0 10px 20px -5px rgba(14, 165, 233, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 28px -5px rgba(14, 165, 233, 0.7);
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.05);
      color: var(--text-main);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(255, 255, 255, 0.2);
      transform: translateY(-2px);
    }

    /* Footer text */
    footer {
      margin-top: 2rem;
      font-size: 0.8rem;
      color: rgba(148, 163, 184, 0.6);
      letter-spacing: 0.02em;
    }

    @media (max-width: 640px) {
      .container {
        padding: 2rem 1.25rem;
      }
      h1 {
        font-size: 1.8rem;
      }
      .stats-grid {
        grid-template-columns: 1fr 1fr;
      }
    }
  </style>
</head>
<body>

  <!-- Ambient Glow Background -->
  <div class="glow-bg glow-1"></div>
  <div class="glow-bg glow-2"></div>
  <div class="grid-pattern"></div>

  <!-- SVG Gradient definition for icons -->
  <svg width="0" height="0" style="position: absolute;">
    <defs>
      <linearGradient id="brandGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#38bdf8"/>
        <stop offset="100%" stop-color="#34d399"/>
      </linearGradient>
    </defs>
  </svg>

  <main class="container">
    
    <!-- Status Badge -->
    <div class="status-badge-wrap">
      <span class="pulse-dot"></span>
      Backend Is Live &amp; Running
    </div>

    <!-- Doctor / Medical Healthcare Icon -->
    <div class="icon-header">
      <svg viewBox="0 0 24 24">
        <!-- Medical Stethoscope & Cross combined aesthetic -->
        <path d="M4.5 3.5v5a7.5 7.5 0 0 0 15 0v-5"/>
        <path d="M12 16v4"/>
        <circle cx="12" cy="20" r="2"/>
        <path d="M9 7h6"/>
        <path d="M12 4v6"/>
      </svg>
    </div>

    <!-- Main Title -->
    <h1>Dr. Manas Aggarwal</h1>
    <p class="subtitle">
      Healthcare Management Platform &amp; Teleconsultation API Backend Services are active and responding normally.
    </p>

    <!-- ECG Animated Wave Line -->
    <div class="ecg-box" title="Live Heartbeat / Vitals Activity">
      <svg class="ecg-svg" preserveAspectRatio="none" viewBox="0 0 1000 60">
        <path d="M0,30 L120,30 L135,10 L150,50 L165,20 L180,38 L195,30 L500,30 L620,30 L635,10 L650,50 L665,20 L680,38 L695,30 L1000,30" 
              fill="none" 
              stroke="#10b981" 
              stroke-width="2.5" 
              stroke-linecap="round"
              stroke-linejoin="round"
              opacity="0.85" />
      </svg>
    </div>

    <!-- Live System Stats Grid -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-label">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          API Status
        </div>
        <div class="stat-value healthy"><%= status %></div>
      </div>

      <div class="stat-card">
        <div class="stat-label">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          Environment
        </div>
        <div class="stat-value"><%= nodeEnv %></div>
      </div>

      <div class="stat-card">
        <div class="stat-label">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Uptime
        </div>
        <div class="stat-value"><%= uptime %></div>
      </div>

      <div class="stat-card">
        <div class="stat-label">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Server Time
        </div>
        <div class="stat-value" id="liveClock" style="font-size: 0.95rem;">--:--:--</div>
      </div>
    </div>

    <!-- Quick Navigation Links -->
    <div class="actions-wrap">
      <a href="/test" class="btn btn-primary" target="_blank">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        Check /test Endpoint
      </a>
      <a href="/express/vistor-count" class="btn btn-secondary" target="_blank">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Visitor Metrics
      </a>
    </div>

    <footer>
      &copy; <%= new Date().getFullYear() %> Dr. Manas Aggarwal Healthcare Portal &bull; All Systems Operational
    </footer>

  </main>

  <script>
    // Live ticking clock for UI dynamism
    function updateClock() {
      const now = new Date();
      const timeStr = now.toLocaleTimeString('en-US', { hour12: true });
      const clockEl = document.getElementById('liveClock');
      if (clockEl) {
        clockEl.textContent = timeStr;
      }
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
